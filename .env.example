# Public canonical origin used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://highlandcabinetry.com

# Search indexing. Leave unset (or anything other than "on") on staging and previews.
# Set to "on" ONLY on the production deployment at launch. See docs/LAUNCH-CHECKLIST.md.
SITE_INDEXING=

# Lead destination. When unset, the quote/dealer forms report that the preview is not
# connected and never show a "request sent" confirmation.
# Any HTTPS endpoint that accepts a JSON POST (CRM webhook, Zapier/Make hook, etc.).
LEAD_WEBHOOK_URL=
# Optional shared secret sent as the "X-Highland-Signature" header (HMAC-SHA256 of the body).
LEAD_WEBHOOK_SECRET=
